{
  "name": "Edge AI System Toolchain (2026)",
  "image": "mcr.microsoft.com/devcontainers/cpp:1-ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "rust-lang.rust-analyzer",
        "twxs.cmake"
      ]
    }
  },
  "mounts": [
    "source=${localWorkspaceFolder}/build,target=/workspace/build,type=bind"
  ],
  "postCreateCommand": "g++ --version && rustc --version"
}
