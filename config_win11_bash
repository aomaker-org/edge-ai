#!/usr/bin/env bash
# ==============================================================================
# Filename:     config_win11_bash
# Purpose:      Top-Level Entrypoint for edge-ai Git Bash Environment Loader
# ==============================================================================
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    echo "[!] ERROR: You must SOURCE this file, not execute it." >&2
    echo "    Usage: source config_win11_bash [force|unset|<tag>]" >&2
    exit 1
fi

_ROOT_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"
source "${_ROOT_DIR}/infra/win11/config_win11_bash" "$@"
