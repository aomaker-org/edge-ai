[
    {
        "guid": "{e83a9120-1122-4a7b-830a-edgeai000001}",
        "name": "edge-ai: Simple Git Bash",
        "commandline": "\"C:\\Program Files\\Git\\bin\\bash.exe\" --login -i",
        "icon": "C:\\Program Files\\Git\\mingw64\\share\\git\\git-for-windows.ico",
        "startingDirectory": "%USERPROFILE%\\src\\edge-ai",
        "hidden": false,
        "bellStyle": "none",
        "closeOnExit": "graceful"
    },
    {
        "guid": "{e83a9120-1122-4a7b-830a-edgeai000002}",
        "name": "edge-ai: Simple PowerShell 7",
        "commandline": "\"C:\\Program Files\\PowerShell\\7\\pwsh.exe\" -NoExit",
