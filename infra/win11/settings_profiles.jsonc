        "name": "edge-ai: Simple Developer CMD",
        "commandline": "cmd.exe /k \"\"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\Common7\\Tools\\VsDevCmd.bat\" -arch=amd64\"",
